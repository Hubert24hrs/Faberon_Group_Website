# Public URL of the site, used for canonical links, the sitemap and structured data.
# Optional on Vercel: when empty, the project's production domain is used, which
# becomes https://faberongroups.com once that domain is added to the project.
NEXT_PUBLIC_SITE_URL=

# Search engines are told not to index the site until this is "true".
# Set it at launch, then redeploy.
SITE_LAUNCHED=

# Google Search Console HTML-tag verification code (the content="..." value only).
# Google Play organisation verification asks you to verify the website this way.
GOOGLE_SITE_VERIFICATION=

# Contact and demo form email, sent through Resend (https://resend.com).
# The from address must be on a domain verified in Resend,
# e.g. "Faberon Group <info@faberongroups.com>".
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Optional lead alerts: a Slack incoming webhook, and a generic CRM webhook
# (Zapier, Make, or a CRM workflow URL). Both must be https.
SLACK_WEBHOOK_URL=
CRM_WEBHOOK_URL=

# Optional Cloudflare Turnstile bot protection on the forms.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional booking embed on /contact. Use a full cal.com or calendly.com URL.
# Leave empty to show the form only.
NEXT_PUBLIC_BOOKING_URL=

# Optional Plausible analytics. Set to the domain registered in Plausible.
# Leave empty to keep analytics off.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
