# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables, then redeploy.
# See docs/DEVELOPER_ACCOUNT_READINESS.md for the values to use at each rollout stage.

# --- Site origin -------------------------------------------------------------
# The single public origin: https, no trailing slash, no path.
# Leave empty on Vercel to use the project's production domain. A production build
# with no origin at all fails with a clear error.
NEXT_PUBLIC_SITE_URL=

# When exactly "true", the hosts in LEGACY_HOSTS permanently (308) redirect to
# NEXT_PUBLIC_SITE_URL. Read at build time: redeploy after changing.
CANONICAL_REDIRECT_ENABLED=
# Comma-separated, e.g. i-dokoai.vercel.app
LEGACY_HOSTS=

# --- Company -----------------------------------------------------------------
# CAC registration number, e.g. 1234567. Empty hides it everywhere.
# Everything else about the company lives in config/company.ts.
NEXT_PUBLIC_COMPANY_RC_NUMBER=

# Google Search Console HTML-tag verification code (the content="..." value only).
GOOGLE_SITE_VERIFICATION=

# --- Email (Resend, https://resend.com) --------------------------------------
RESEND_API_KEY=
# Sender, on a domain verified in Resend, e.g. Company <no-reply@example.com>.
# Falls back to CONTACT_FROM_EMAIL.
EMAIL_FROM=
# Reply-to on emails sent to visitors. Falls back to the leads inbox.
EMAIL_REPLY_TO=
# Where contact and demo requests go. Falls back to CONTACT_TO_EMAIL.
LEADS_NOTIFY_EMAIL=
# Where support requests go. Falls back to LEADS_NOTIFY_EMAIL.
SUPPORT_NOTIFY_EMAIL=
# Where account deletion and privacy requests go. Falls back to LEADS_NOTIFY_EMAIL.
PRIVACY_NOTIFY_EMAIL=
# Older names, still honoured as fallbacks.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# --- Optional integrations ---------------------------------------------------
# Lead alerts: a Slack incoming webhook and a generic CRM webhook. Both must be https.
SLACK_WEBHOOK_URL=
CRM_WEBHOOK_URL=

# Cloudflare Turnstile bot protection on the forms.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Booking embed on /contact: a full cal.com or calendly.com URL.
NEXT_PUBLIC_BOOKING_URL=

# Plausible analytics: the domain registered in Plausible.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
